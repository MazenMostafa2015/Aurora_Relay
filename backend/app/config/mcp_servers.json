{
  "mcpServers": {
    "browser": {
      "command": "python3",
      "args": ["-m", "mcp_servers.browser.server"],
      "env": {
        "PYTHONPATH": "/home/ubuntu/projects/mcp-aplication-36e0710f"
      },
      "allowedTools": ["browse_url", "search_web", "click_element", "extract_data", "fill_form", "wait_for", "take_screenshot"],
      "timeout": 30,
      "maxRetries": 2,
      "retryBaseDelay": 0.25
    },
    "filesystem": {
      "command": "python3",
      "args": ["-m", "mcp_servers.filesystem.server"],
      "env": {
        "PYTHONPATH": "/home/ubuntu/projects/mcp-aplication-36e0710f",
        "WORKSPACE_DIR": "/home/ubuntu/projects/mcp-aplication-36e0710f/workspace"
      },
      "allowedTools": ["read_file", "write_file", "list_directory", "delete_file", "get_file_info"],
      "timeout": 30,
      "maxRetries": 2,
      "retryBaseDelay": 0.25
    },
    "connector_management": {
      "command": "python3",
      "args": ["-m", "backend.app.core.mcp_servers.connector_management.server"],
      "env": {
        "PYTHONPATH": "."
      },
      "allowedTools": ["list_available_connectors", "test_connector", "github_connector_action", "revit_plan_change", "revit_apply_confirmed_change"],
      "timeout": 30,
      "maxRetries": 1,
      "retryBaseDelay": 0.25
